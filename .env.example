# Auriva backend — example environment configuration.
#
# Copy this file to `.env` and fill in real values for your environment.
# Every variable listed here is genuinely read somewhere in this
# repository (index.js / src/config / src/services / scripts) — this file
# does not invent any variable the app does not actually use.
#
# PLACEHOLDERS ONLY. Never commit a real .env file, a real database URL, a
# real JWT secret, or real Azure/SMTP credentials.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Schema sync — LEAVE UNSET unless you know exactly what you are doing.
#
# When true, startup runs sequelize.sync({ alter: { drop: false } }), which
# ALTERs the schema of whatever database DB_HOST points at. Every developer's
# NODE_ENV is 'development' and every developer points at the SHARED Azure
# database, so a sync here changes the schema for the whole team, not just you.
#
# The old code keyed this on NODE_ENV alone. That is how students.reduce_stimulation
# and five other columns were repeatedly dropped — 58 DROP COLUMN events between
# 2026-07-24 and 2026-08-29 — each one 500-ing the app for everyone.
#
# Only ever set this against a disposable local database. For real schema
# changes, write a migration in migrations/ instead.
# ALLOW_DB_SYNC=false

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auriva_dev
DB_USER=postgres
DB_PASSWORD=changeme

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────
# Falls back to '*' when unset — an accepted development/pilot-stage
# default (see index.js's own CORS comment). Set to your actual frontend
# origin before any production deployment.
CORS_ORIGIN=*

# ── ML service (Node -> FastAPI, never React Native -> FastAPI directly) ──
# Falls back to http://localhost:8000 when unset — correct only when the
# ML service runs on the same machine as this backend. On a physical
# device test, this stays a Node-side setting; the tablet never talks to
# this URL or port itself.
ML_SERVICE_URL=http://localhost:8000

# Unrelated pre-existing Concept Learning module dependency (not part of
# the handwriting/ML pipeline audited this session). Same
# same-machine-default caveat as ML_SERVICE_URL above.
GNN_SERVICE_URL=http://localhost:8000

# ── Trajectory ML hybrid (TASK-05 / R-39) ────────────────────────────────
TRAJECTORY_ML_ENABLED=false
MICROSERVICE_URL=http://localhost:5001
# Provisional (2026-08-19) — 0.60 is tuned against UNCALIBRATED raw-model
# probabilities: the shipped artifact carries no calibrator, so app.py falls back
# to RandomForest predict_proba. Re-derive this value if a calibrator is restored.
TRAJECTORY_MIN_CONFIDENCE=0.60

# ── Azure Blob Storage ──────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=changeme
AZURE_STORAGE_ACCOUNT_KEY=changeme
AZURE_BLOB_CONTAINER=changeme

# ── Email (password reset OTP) ───────────────────────────────────────────
SMTP_EMAIL=changeme@example.com
SMTP_APP_PASSWORD=changeme

# ── One-time seed script only (scripts/seed.js) — not read by the running
# app itself ──────────────────────────────────────────────────────────────
PRINCIPAL_USERNAME=changeme
PRINCIPAL_PASSWORD=changeme
